{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "functions": {
    "app/api/queues/email-notifications/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "email-notifications"
        }
      ]
    },
    "app/api/queues/phone-verifications/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "phone-verifications"
        }
      ]
    },
    "app/api/queues/application-bulk-operations/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "application-bulk-operations"
        }
      ]
    }
  }
}
