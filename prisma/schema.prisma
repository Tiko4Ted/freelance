generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REFERRER
  CANDIDATE
  ADMIN
}

enum PayoutTrigger {
  HOURS_10
  TASK_1
}

enum ApplicationStatus {
  APPLIED
  CERTIFYING
  CERTIFIED
  MATCHED
  ACTIVE
  PAYOUT_ELIGIBLE
  PAID
  EXPIRED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model User {
  id                 String      @id @default(uuid())
  email              String      @unique
  passwordHash       String
  name               String
  role               Role        @default(REFERRER)
  referralCode       String      @unique @default(uuid())
  walletBalanceCents Int         @default(0)
  payoutProvider     String?
  payoutAccountId    String?
  payoutAccountReady Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  referrals          Referral[]
  ledgerEntries      LedgerEntry[]
  withdrawals        Withdrawal[]

  @@index([role])
}

model Job {
  id                String        @id @default(uuid())
  title             String        @unique
  description       String
  payoutAmountCents Int
  payoutType        PayoutTrigger @default(HOURS_10)
  currency          String        @default("USD")
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  applications      Application[]
  referrals         Referral[]

  @@index([isActive])
}

model Application {
  id                String            @id @default(uuid())
  jobId             String
  job               Job               @relation(fields: [jobId], references: [id])
  candidateEmail    String
  candidateName     String
  referralId        String?           @unique
  referral          Referral?         @relation(fields: [referralId], references: [id])
  status            ApplicationStatus @default(APPLIED)
  lockedPayoutCents Int?
  hoursLogged       Float             @default(0)
  tasksCompleted    Int               @default(0)
  onboardedAt       DateTime?
  payoutDeadline    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  ledgerEntry       LedgerEntry?

  @@unique([candidateEmail, jobId])
  @@index([candidateEmail])
  @@index([status])
  @@index([payoutDeadline])
}

model Referral {
  id          String       @id @default(uuid())
  referrerId  String
  referrer    User         @relation(fields: [referrerId], references: [id])
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id])
  clickedAt   DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  application Application?

  @@index([referrerId])
  @@index([jobId])
}

model CandidateIdentity {
  email                     String   @id
  firstMatchedApplicationId String?  @unique
  hasBeenPaidOut            Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model LedgerEntry {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  amountCents   Int
  reason        String
  applicationId String?      @unique
  application   Application? @relation(fields: [applicationId], references: [id])
  withdrawalId  String?
  withdrawal    Withdrawal?  @relation(fields: [withdrawalId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([withdrawalId])
}

model Withdrawal {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  amountCents      Int
  status           WithdrawalStatus @default(PENDING)
  providerPayoutId String?
  requestedAt      DateTime         @default(now())
  completedAt      DateTime?
  failureReason    String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  ledgerEntries    LedgerEntry[]

  @@index([userId])
  @@index([status])
}
