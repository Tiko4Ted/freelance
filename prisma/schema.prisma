generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REFERRER
  CANDIDATE
  ADMIN
}

enum PayoutTrigger {
  HOURS_10
  TASK_1
}

enum ApplicationStatus {
  APPLIED
  CERTIFYING
  CERTIFIED
  MATCHED
  ACTIVE
  PAYOUT_ELIGIBLE
  PAID
  EXPIRED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum LedgerAccount {
  HOLDING
  FUNDING
  LEGACY
}

enum WalletTransferType {
  HOLDING_TO_FUNDING
}

enum WalletTransferStatus {
  COMPLETED
  FAILED
}

enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role      @default(REFERRER)
  referralCode        String    @unique @default(uuid())
  walletBalanceCents  Int       @default(0)
  holdingBalanceCents Int       @default(0)
  fundingBalanceCents Int       @default(0)
  payoutProvider      String?
  payoutAccountId     String?
  payoutAccountReady  Boolean   @default(false)
  emailVerifiedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  referrals                   Referral[]
  ledgerEntries               LedgerEntry[]
  withdrawals                 Withdrawal[]
  walletTransfers             WalletTransfer[]
  freelanceVerification       UserFreelanceVerification?
  onboarding                  UserOnboarding?
  freelanceVerificationAudits FreelanceIdentityVerificationAudit[]
  applications                Application[]
  emailVerificationToken      EmailVerificationToken?

  @@index([role])
}

model EmailVerificationToken {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model NotificationJob {
  id                String                @id @default(uuid())
  kind              String
  status            NotificationJobStatus @default(PENDING)
  attempts          Int                   @default(0)
  providerMessageId String?
  lastError         String?
  lockedAt          DateTime?
  sentAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([kind, status])
}

model UserOnboarding {
  userId                           String    @id
  user                             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ndaSignedAt                      DateTime?
  ndaSignerName                    String?
  ndaSignerTitle                   String?
  ndaSignatureText                 String?
  dataSubmissionSignedAt           DateTime?
  dataSubmissionSignerName         String?
  dataSubmissionSignerTitle        String?
  dataSubmissionSignatureText      String?
  phoneCountryCode                 String?
  phoneNumber                      String?
  phoneVerifiedAt                  DateTime?
  phoneVerificationCodeHash        String?
  phoneVerificationExpiresAt       DateTime?
  phoneVerificationAttempts        Int       @default(0)
  phoneVerificationSentAt          DateTime?
  phoneVerificationSendCount       Int       @default(0)
  phoneVerificationWindowStartedAt DateTime?
  identityLegalName                String?
  identityDateOfBirth              DateTime?
  identityDocumentType             String?
  identityDocumentLast4            String?
  identityVerifiedAt               DateTime?
  paymentMethod                    String?
  paymentDestination               String?
  paymentSetupAt                   DateTime?
  completedAt                      DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
}

model Job {
  id                String        @id @default(uuid())
  title             String        @unique
  description       String
  payoutAmountCents Int
  payoutType        PayoutTrigger @default(HOURS_10)
  currency          String        @default("USD")
  isActive          Boolean       @default(true)
  companyName       String        @default("Trinity-AI")
  openings          Int           @default(1)
  hourlyMinCents    Int?
  hourlyMaxCents    Int?
  postedAt          DateTime      @default(now())
  isHighDemand      Boolean       @default(false)
  showOnHome        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  applications Application[]
  referrals    Referral[]
  skills       JobSkill[]

  @@index([isActive])
  @@index([showOnHome, isActive, postedAt])
  @@index([postedAt])
}

model JobSkill {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label String

  @@index([jobId])
}

model Application {
  id                        String            @id @default(uuid())
  applicantUserId           String?
  applicant                 User?             @relation(fields: [applicantUserId], references: [id], onDelete: SetNull)
  jobId                     String
  job                       Job               @relation(fields: [jobId], references: [id])
  candidateEmail            String
  candidateName             String
  candidateFirstName        String?
  candidateLastName         String?
  candidatePhoneCountry     String?
  candidatePhoneCountryCode String?
  candidatePhoneNumber      String?
  candidateLinkedinUrl      String?
  resumeFileName            String?
  startAvailabilityDays     Int?
  expectedHourlyRateUsd     Int?
  weeklyAvailabilityHours   Int?
  strongestTools            String[]          @default([])
  aptitudeAnswers           Json?
  aptitudeScorePercent      Int?
  aptitudeCorrectAnswers    Int               @default(0)
  aptitudeQuestionCount     Int               @default(0)
  aptitudePassed            Boolean           @default(false)
  aptitudeSubmittedAt       DateTime?
  referralId                String?           @unique
  referral                  Referral?         @relation(fields: [referralId], references: [id])
  status                    ApplicationStatus @default(APPLIED)
  lockedPayoutCents         Int?
  hoursLogged               Float             @default(0)
  tasksCompleted            Int               @default(0)
  taskSubmissionFileName    String?
  taskSubmissionNotes       String?
  taskSubmittedAt           DateTime?
  onboardedAt               DateTime?
  payoutDeadline            DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  ledgerEntry LedgerEntry?

  @@unique([applicantUserId, jobId])
  @@unique([candidateEmail, jobId])
  @@index([applicantUserId])
  @@index([candidateEmail])
  @@index([status])
  @@index([payoutDeadline])
}

model Referral {
  id          String       @id @default(uuid())
  referrerId  String
  referrer    User         @relation(fields: [referrerId], references: [id])
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id])
  clickedAt   DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  application Application?

  @@index([referrerId])
  @@index([jobId])
}

model CandidateIdentity {
  email                     String   @id
  firstMatchedApplicationId String?  @unique
  hasBeenPaidOut            Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model FreelanceIdentityReference {
  id              String   @id @default(uuid())
  freelanceIdCode String   @unique
  serialNumber    String   @unique
  legalName       String
  dateOfBirth     DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verification UserFreelanceVerification?
  syncRequests FreelanceIdentitySyncRequest[]
}

model FreelanceIdentitySyncRequest {
  idempotencyKey      String                      @id
  payloadHash         String
  payload             Json
  identityReferenceId String?
  identityReference   FreelanceIdentityReference? @relation(fields: [identityReferenceId], references: [id], onDelete: SetNull)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([identityReferenceId])
}

model FreelanceIdentityVerificationAudit {
  id                       String   @id @default(uuid())
  userId                   String?
  user                     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress                String?
  userAgent                String?
  attemptedFreelanceIdHash String?
  attemptedSerialHash      String?
  outcome                  String
  reason                   String?
  createdAt                DateTime @default(now())

  @@index([userId])
  @@index([ipAddress])
  @@index([outcome])
  @@index([createdAt])
}

model UserFreelanceVerification {
  id              String                     @id @default(uuid())
  userId          String                     @unique
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelanceIdCode String                     @unique
  serialNumber    String                     @unique
  reference       FreelanceIdentityReference @relation(fields: [freelanceIdCode], references: [freelanceIdCode])
  legalName       String
  dateOfBirth     DateTime
  verifiedAt      DateTime                   @default(now())
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  walletTransfers WalletTransfer[]
}

model WalletTransfer {
  id             String                     @id @default(uuid())
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  amountCents    Int
  type           WalletTransferType         @default(HOLDING_TO_FUNDING)
  status         WalletTransferStatus       @default(COMPLETED)
  verificationId String?
  verification   UserFreelanceVerification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@index([verificationId])
}

model LedgerEntry {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  amountCents   Int
  account       LedgerAccount   @default(FUNDING)
  reason        String
  applicationId String?         @unique
  application   Application?    @relation(fields: [applicationId], references: [id])
  withdrawalId  String?
  withdrawal    Withdrawal?     @relation(fields: [withdrawalId], references: [id])
  transferId    String?
  transfer      WalletTransfer? @relation(fields: [transferId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([withdrawalId])
  @@index([transferId])
  @@index([account])
}

model Withdrawal {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  amountCents        Int
  status             WithdrawalStatus @default(PENDING)
  payoutMethod       String?
  destinationDetails Json?
  providerPayoutId   String?
  requestedAt        DateTime         @default(now())
  completedAt        DateTime?
  failureReason      String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([userId])
  @@index([status])
}
