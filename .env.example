DATABASE_URL="postgresql://postgres:postgres@localhost:5432/referraljobs?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
# Required for self-hosted/local Auth.js deployments behind trusted app hosts.
AUTH_TRUST_HOST="true"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

REDIS_URL=""

RESEND_API_KEY=""
EMAIL_FROM="Trinity-AI <onboarding@resend.dev>"
APP_URL="https://freelance-nu-swart.vercel.app"

# Internal sync from the standalone ID generator.
# Production intent is mTLS at the reverse proxy; this app-level token is the documented fallback.
ID_GENERATOR_SYNC_BEARER_TOKEN="replace-with-a-rotated-high-entropy-token"

# Server-only Africa's Talking SMS configuration. Never prefix these with NEXT_PUBLIC_.
AFRICAS_TALKING_USERNAME=""
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_SENDER_ID=""
AFRICAS_TALKING_ENVIRONMENT=production

# Optional dedicated HMAC key for OTP hashes. AUTH_SECRET is used as a fallback.
PHONE_VERIFICATION_SECRET=""
